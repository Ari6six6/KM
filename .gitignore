# KM keeps no build artifacts — the script is the point. This is mostly hygiene.
*.log
*.tmp
.DS_Store

# never commit runtime state or secrets (KM writes these on the operator's machine)
.km/
state.json
*.km-backup.*
.env

# the team musketeers each get an isolated Pi home here — runtime state, not source
team/homes/

# the live board is your working channel, not source — freeze it with a plain cp
team/board/board.md

# node, only if you develop the extension locally
node_modules/
