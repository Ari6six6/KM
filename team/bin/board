#!/usr/bin/env bash
# board — show the KM board.
#
#   board        # print the whole board
#   board -f     # follow it live (Ctrl-C to stop)
#
# The board is one shared file: team/board/board.md.
set -euo pipefail
TEAM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BOARD="$TEAM_ROOT/board/board.md"

[ -f "$BOARD" ] || { echo "board is empty — nothing posted yet ($BOARD)"; exit 0; }

if [ "${1:-}" = "-f" ]; then
  exec tail -n +1 -f "$BOARD"
fi
cat "$BOARD"
