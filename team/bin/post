#!/usr/bin/env bash
# post — append an attributed, timestamped message to the KM board.
#
#   post <who> "a short message"     # one-liner
#   post <who>                       # then paste, end with Ctrl-D  (reads stdin)
#   some-command | post <who>        # pipe anything in
#
# <who> is free text: operator, claude, grok, kimi, or whatever you like.
# The board is one shared file: team/board/board.md — everyone reads and writes it.
set -euo pipefail
TEAM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BOARD="$TEAM_ROOT/board/board.md"

who="${1:-operator}"
if [ "$#" -ge 2 ]; then
  shift
  body="$*"
else
  body="$(cat)"          # no message given → read stdin (paste, then Ctrl-D)
fi

mkdir -p "$(dirname "$BOARD")"
[ -f "$BOARD" ] || printf '# KM board\n\nThe shared channel. Paste here, or use `post`. Read with `board`.\n' > "$BOARD"

{
  printf '\n---\n\n### %s · %s\n\n' "$who" "$(date '+%Y-%m-%d %H:%M:%S')"
  printf '%s\n' "$body"
} >> "$BOARD"

echo "posted to board as $who"
